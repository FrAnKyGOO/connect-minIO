# Local development values only. Replace these before using the project beyond your machine.
POSTGRES_DB=connect_minio
POSTGRES_USER=connect_minio
POSTGRES_PASSWORD=local_dev_change_me

DATABASE_URL=postgresql://connect_minio:local_dev_change_me@127.0.0.1:5433/connect_minio?schema=public

MINIO_ROOT_USER=minio_local
MINIO_ROOT_PASSWORD=local_minio_change_me_123
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=files

# Uploads are buffered in memory by the starter API; max request file size is 10 MiB.
MAX_UPLOAD_BYTES=10485760

# Replace with a random secret of at least 32 bytes before using JWT.
JWT_SECRET=replace_this_with_a_random_secret_at_least_32_bytes_long
